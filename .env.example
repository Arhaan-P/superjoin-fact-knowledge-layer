# --- Gemini (primary extraction + relationship-judgment provider) ---
GEMINI_API_KEY=

# Extra Gemini keys to rotate to once every model below is daily-quota-exhausted on
# the current key. IMPORTANT: free-tier quota is tied to the underlying Google
# Cloud/AI Studio *project*, not the individual key -- generating another key inside
# the same project will NOT add capacity. Only list keys from genuinely separate
# accounts/projects. Comma-separated. Optional -- leave blank if you only have one.
GEMINI_API_KEY_FALLBACKS=

# Pinned deliberately (not "whatever's latest") -- free-tier daily quotas (20
# req/day/model as observed) mean a newer model doesn't help if today's quota on the
# current one is already spent. GEMINI_MODEL_FALLBACKS is tried in order, per key,
# whenever a model's *daily* quota (not a transient per-minute rate limit) is hit.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash

# --- Groq (relationship-judgment fallback once every Gemini key x model combination
# is exhausted -- a separate provider entirely, so it draws from its own quota pool
# rather than competing with Gemini's) ---
GROQ_API_KEY=
# llama-3.3-70b-versatile (CLAUDE.md's original pick) was deprecated on Groq's API;
# openai/gpt-oss-120b is the current replacement. Check client.models.list() if this
# ever 404s again -- Groq's free-tier catalog changes over time.
GROQ_MODEL=openai/gpt-oss-120b
# Same rotation idea as GEMINI_API_KEY_FALLBACKS, tried on Groq rate limits. Optional.
GROQ_API_KEY_FALLBACKS=

# --- Extraction batching / retry tuning ---
# Pages sent to Gemini in a single call (PRD section 5 step 2) -- large enough to
# keep request count low on the free-tier RPM cap, small enough that one call's
# output stays within a reasonable token budget.
PAGES_PER_BATCH=8
EXTRACT_MAX_RETRIES=5
# Spacing between batch calls so we don't rely on retry-after-429 alone to stay
# under the free tier's ~10-15 req/min cap.
EXTRACT_MIN_SECONDS_BETWEEN_CALLS=4.5

# --- Storage ---
RELATIONSHIPS_DB_PATH=storage/relationships.db
